generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (Better Auth)
// ============================================================

enum Peran {
  owner
  petugas
  siswa
}

model Akun {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Peran    @default(siswa)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sesi       Sesi[]
  kredensial Kredensial[]
  siswa      Siswa?

  @@map("akun")
}

model Sesi {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  akunId String
  akun   Akun   @relation(fields: [akunId], references: [id], onDelete: Cascade)

  @@map("sesi")
}

model Kredensial {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  akunId String
  akun   Akun   @relation(fields: [akunId], references: [id], onDelete: Cascade)

  @@map("kredensial")
}

model Verifikasi {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifikasi")
}

// ============================================================
// DOMAIN
// ============================================================

model ProfilSekolah {
  id                String  @id @default(cuid())
  nama              String
  alamat            String?
  logoUrl           String?
  nominalSppDefault Int
  noHpBendahara     String?
  fonnteToken       String?

  @@map("profil_sekolah")
}

enum JenisKelamin {
  L
  P
}

enum StatusSiswa {
  aktif
  lulus
  pindah
  nonaktif
}

model Siswa {
  id            String       @id @default(cuid())
  akunId        String?      @unique
  akun          Akun?        @relation(fields: [akunId], references: [id], onDelete: SetNull)
  kelasId       String?
  kelas         Kelas?       @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  nis           String       @unique
  nisn          String?      @unique
  namaLengkap   String
  jenisKelamin  JenisKelamin
  tanggalLahir  DateTime?
  namaWali      String?
  kontakWali    String?
  fotoUrl       String?      @db.LongText
  status        StatusSiswa  @default(aktif)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tagihan    TagihanSpp[]
  pembayaran Pembayaran[]

  tagihanLain    TagihanLain[]
  pembayaranLain PembayaranLain[]
  arsipDigital   ArsipDigital[]

  @@index([namaLengkap])
  @@index([kelasId])
  @@index([status])
  @@map("siswa")
}

model Kelas {
  id         String  @id @default(cuid())
  namaKelas  String
  tingkat    Int
  nominalSpp Int?    @default(0)
  waliKelas  String?

  siswa Siswa[]

  @@map("kelas")
}

model TahunAjaran {
  id    String  @id @default(cuid())
  nama  String
  aktif Boolean @default(false)

  tagihan          TagihanSpp[]
  tagihanLain      TagihanLain[]
  jatuhTempoPreset JatuhTempoPreset[]

  @@map("tahun_ajaran")
}

enum JenisPreset {
  spp
  lainnya
}

model JatuhTempoPreset {
  id            String      @id @default(cuid())
  nama          String // Label bebas, misal "Seragam Gel.1 - 30 Agt"
  tanggalAwal   DateTime    @default(now()) // default cuma buat backfill row lama pas migrasi, POST/PATCH selalu kirim eksplisit
  tanggalAkhir  DateTime    @default(now())
  jenis         JenisPreset // "spp" atau "lainnya" — dipisah biar gak campur di dropdown Generate
  tahunAjaranId String
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("jatuh_tempo_preset")
}

enum StatusTagihan {
  belum_bayar
  menunggu_verifikasi
  lunas
  terlambat
}

model TagihanSpp {
  id            String        @id @default(cuid())
  siswaId       String
  siswa         Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tahunAjaranId String
  tahunAjaran   TahunAjaran   @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict)
  bulan         Int
  tahun         Int
  nominal       Int
  jatuhTempo    DateTime
  status        StatusTagihan @default(belum_bayar)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pembayaran Pembayaran[]

  @@unique([siswaId, tahunAjaranId, bulan, tahun])
  @@index([status])
  @@index([bulan, tahun])
  @@index([siswaId])
  @@map("tagihan_spp")
}

enum StatusPembayaran {
  pending
  success
  failed
  expired
}

model Pembayaran {
  id                    String           @id @default(cuid())
  tagihanSppId          String
  tagihan               TagihanSpp       @relation(fields: [tagihanSppId], references: [id], onDelete: Cascade)
  siswaId               String
  siswa                 Siswa            @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  orderId               String           @unique
  jumlah                Int
  metode                String
  midtransTransactionId String?
  status                StatusPembayaran @default(pending)
  rawResponse           Json?
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@index([siswaId])
  @@index([tagihanSppId])
  @@map("pembayaran")
}

enum Environment {
  sandbox
  production
}

model PengaturanPembayaran {
  id                  String      @id @default(cuid())
  environment         Environment @default(sandbox)
  sandboxClientKey    String?
  sandboxServerKey    String?
  productionClientKey String?
  productionServerKey String?
  updatedAt           DateTime    @updatedAt

  @@map("pengaturan_pembayaran")
}

// ============================================================
// TAGIHAN LAINNYA (seragam, daftar ulang, dll — di luar SPP bulanan)
// Tabel terpisah dari TagihanSpp/Pembayaran secara sengaja (Tahap 6):
// supaya kode SPP yang udah stabil (bayar, verifikasi, webhook Midtrans)
// gak ikut kesentuh/keresiko. Reuse enum StatusTagihan & StatusPembayaran
// yang sama biar konsisten sama modul SPP.
// ============================================================

model JenisTagihanLain {
  id             String   @id @default(cuid())
  nama           String // "Seragam", "Daftar Ulang", dll — bebas ditambah admin
  nominalDefault Int      @default(0)
  aktif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tagihan TagihanLain[]

  @@map("jenis_tagihan_lain")
}

model TagihanLain {
  id                 String        @id @default(cuid())
  siswaId            String
  siswa              Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  jenisTagihanLainId String
  jenisTagihanLain   JenisTagihanLain @relation(fields: [jenisTagihanLainId], references: [id], onDelete: Restrict)
  tahunAjaranId      String?
  tahunAjaran        TahunAjaran?  @relation(fields: [tahunAjaranId], references: [id], onDelete: SetNull)
  nominal            Int
  jatuhTempo         DateTime
  status             StatusTagihan @default(belum_bayar)
  keterangan         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  pembayaran PembayaranLain[]

  @@index([status])
  @@index([siswaId])
  @@index([jenisTagihanLainId])
  @@map("tagihan_lain")
}

model PembayaranLain {
  id                    String           @id @default(cuid())
  tagihanLainId         String
  tagihan               TagihanLain      @relation(fields: [tagihanLainId], references: [id], onDelete: Cascade)
  siswaId               String
  siswa                 Siswa            @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  orderId               String           @unique
  jumlah                Int
  metode                String
  midtransTransactionId String?
  status                StatusPembayaran @default(pending)
  rawResponse           Json?
  paidAt                DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status])
  @@index([siswaId])
  @@index([tagihanLainId])
  @@map("pembayaran_lain")
}

// ============================================================
// PENGUMUMAN
// ============================================================

model Pengumuman {
  id        String   @id @default(cuid())
  judul     String
  isi       String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pengumuman")
}

// ============================================================
// KEUANGAN (PENDAPATAN, PENGELUARAN, UTANG PEGAWAI)
// ============================================================

model PendapatanLain {
  id         String   @id @default(cuid())
  judul      String
  kategori   String   @default("Lain-lain")
  nominal    Int
  tanggal    DateTime @default(now())
  keterangan String?  @db.Text
  penerima   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pendapatan_lain")
}

model Pengeluaran {
  id              String   @id @default(cuid())
  judul           String
  kategori        String   @default("Lain-lain")
  nominal         Int
  tanggal         DateTime @default(now())
  penanggungJawab String?
  buktiUrl        String?  @db.LongText
  keterangan      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("pengeluaran")
}

model UtangPegawai {
  id              String   @id @default(cuid())
  namaPegawai     String
  jabatan         String?
  nominalPinjaman Int
  nominalTerbayar Int      @default(0)
  status          String   @default("aktif") // "aktif", "lunas"
  tanggalPinjam   DateTime @default(now())
  keterangan      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("utang_pegawai")
}

/**
 * BUG YANG DIPERBAIKI: model ini sebelumnya HILANG dari schema sama sekali,
 * padahal app/api/arsip/route.ts, app/api/arsip/[id]/route.ts, dan
 * app/admin/arsip/page.tsx semua sudah lengkap makai `prisma.arsipDigital`.
 * Tanpa model ini, Prisma Client gak pernah generate field/method itu, jadi
 * SETIAP request ke fitur Arsip Digital pasti crash runtime (bukan cuma
 * error tipe) — fitur ini 100% gak bisa dipakai sampai model ini ada.
 * Field & nama disamakan persis dengan yang sudah dipakai kode existing
 * (kategori: bukti_transfer/kwitansi/surat/dokumen_siswa — lihat
 * KATEGORI_LABEL di app/admin/arsip/page.tsx; fileType: pdf/image).
 */
model ArsipDigital {
  id          String   @id @default(cuid())
  judul       String
  kategori    String
  fileUrl     String   @db.Text
  fileType    String
  siswaId     String?
  siswa       Siswa?   @relation(fields: [siswaId], references: [id], onDelete: SetNull)
  tanggal     DateTime @default(now())
  keterangan  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kategori])
  @@index([siswaId])
  @@index([tanggal])
  @@map("arsip_digital")
}
